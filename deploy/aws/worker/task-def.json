{
  "family": "orders-worker",
  "requiresCompatibilities": ["FARGATE"],
  "networkMode": "awsvpc",
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "arn:aws:iam::123456789012:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::123456789012:role/orders-worker-task",
  "containerDefinitions": [
    {
      "name": "worker",
      "image": "PLACEHOLDER_REPLACED_BY_WORKFLOW",
      "essential": true,
      "environment": [{ "name": "APP_ENV", "value": "stage" }],
      "secrets": [
        {
          "name": "BROKER_URL",
          "valueFrom": "arn:aws:ssm:eu-central-1:123456789012:parameter/orders-worker/broker-url"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/orders-worker",
          "awslogs-region": "eu-central-1",
          "awslogs-stream-prefix": "worker"
        }
      }
    }
  ]
}
