# Cloud-independent mobile CD. One `deploy` lane per platform; the target track
# is chosen from DEPLOY_ENV (stage|preprod|prod) set by the calling workflow.

platform :ios do
  desc "Build and ship iOS to TestFlight / App Store per DEPLOY_ENV"
  lane :deploy do
    setup_ci # keychain for CI
    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_KEY_P8"],
      is_key_content_base64: true
    )
    match(type: "appstore", readonly: true) # certs/profiles from the private match repo
    build_app(scheme: ENV["IOS_SCHEME"], export_method: "app-store")

    env = ENV["DEPLOY_ENV"] || "stage"
    if env == "prod"
      upload_to_app_store(api_key: api_key, submit_for_review: true,
                          automatic_release: false, force: true)
    else
      external = env == "preprod"
      upload_to_testflight(api_key: api_key,
                           distribute_external: external,
                           groups: external ? [ENV["TF_EXTERNAL_GROUP"]] : nil,
                           notify_external_testers: external)
    end
  end
end

platform :android do
  desc "Build and ship Android AAB to Play per DEPLOY_ENV"
  lane :deploy do
    env = ENV["DEPLOY_ENV"] || "stage"
    track = { "stage" => "internal", "preprod" => "beta", "prod" => "production" }[env]
    gradle(task: "bundle", build_type: "Release")
    upload_to_play_store(
      track: track,
      aab: ENV["AAB_PATH"] || "app/build/outputs/bundle/release/app-release.aab",
      json_key_data: ENV["PLAY_JSON_KEY"],
      release_status: env == "prod" ? "completed" : "draft"
    )
  end
end
