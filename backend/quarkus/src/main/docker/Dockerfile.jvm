FROM maven:3.9-eclipse-temurin-21-alpine AS build
WORKDIR /src
COPY pom.xml .
RUN mvn -q -B dependency:go-offline
COPY src ./src
RUN mvn -q -B package -DskipTests

FROM eclipse-temurin:21-jre-alpine
RUN addgroup -S app && adduser -S -G app app
COPY --from=build /src/target/quarkus-app/lib/ /deployments/lib/
COPY --from=build /src/target/quarkus-app/*.jar /deployments/
COPY --from=build /src/target/quarkus-app/app/ /deployments/app/
COPY --from=build /src/target/quarkus-app/quarkus/ /deployments/quarkus/
# app.datastore/APP_ENV-equivalent (%dev/%staging/%prod via
# quarkus.profile): see .ai/architecture.md#config — deployer sets it.
USER app:app
EXPOSE 8080 9090
ENTRYPOINT ["java", "-Dquarkus.http.host=0.0.0.0", "-jar", "/deployments/quarkus-run.jar"]
